{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "\"$(hyde-shell fastfetch logo)\"",
    "height": 25
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "host",
      "key": "  󰢮  MRB",
      "keyColor": "white",  
      "format": "MSI {2}"
    },
    {
      "type": "custom",
      "format": "┌─────────────────── Hardware ──────────────────┐"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{1}",
      "keyColor": "magenta"   
    },
    {
      "type": "gpu",
      "key": "  󰊴 GPU",
      "format": "{1} {2}",
      "keyColor": "magenta"   
    },
    {
      "type": "memory",
      "key": "   RAM ",
      "keyColor": "blue"   
    },
    {
      "type": "disk",
      "key": "   Disk",
      "keyColor": "blue"   
    },
    {
      "type": "swap",
      "key": "  󰓡 Swap",
      "keyColor": "blue"   
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "#8be9fd"   
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────────┘"
    },
    "break",
    
    {
      "type": "title",
      "key": "   GitHub",
      "keyColor": "white",  
      "format": "TomLaclavere"
    },
    {
      "type": "custom",
      "format": "┌─────────────────── Software ──────────────────┐"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM   ",
      "format": "{2}",
      "keyColor": "yellow"   
    },
    {
      "type": "theme",
      "key": "  󰉼 Theme",
      "keyColor": "yellow",  
      "format": "{2}"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "green"   
    },
    {
      "type": "shell",
      "key": "   Shell   ",
      "keyColor": "green"   
    },
    {
      "type": "editor",
      "key": "  󰨞 Editor  ",
      "keyColor": "green"   
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "   GPU Driver",
      "keyColor": "red"   
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────────┘"
    },
    "break",

    {
      "type": "title",
      "key": "    User",
      "format": "{6} {7} {8}",
      "keyColor": "#f8f8f2"   
    },
    {
      "type": "custom",
      "format": "┌──────────────────────── OS ───────────────────┐"
    },
    {
      "type": "os",
      "key": "  󰣇 OS      ",
      "format": "{2}",
      "keyColor": "magenta"  
    },
    {
      "type": "kernel",
      "key": "   Kernel  ",
      "format": "{2}",
      "keyColor": "magenta"  
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "magenta"  
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "blue"   
    },
    {
      "type": "disk",
      "key": "  󰅐 OS Age",
      "keyColor": "blue",  
      "folders": "/",
      "format": "{days} days"
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
