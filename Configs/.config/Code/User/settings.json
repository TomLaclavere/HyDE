{
  "C_Cpp.intelliSenseEngine": "disabled",
  "editor.mouseWheelScrollSensitivity": 5,
  "jupyter.askForKernelRestart": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "python": true,
    "latex": false
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/dist": true
  },
  "Key Promoter.ignoredCommands": [
    "type",
    "undo",
    "workbench.action.quickOpen",
    "workbench.action.files.save",
    "deleteLeft",
    "tab",
    "editor.action.clipboardPasteAction",
    "editor.action.clipboardCopyAction",
    "editor.action.selectAll",
    "editor.action.insertCursorBelow",
    "editor.action.commentLine",
    "workbench.action.Editor",
    "redo",
    "workbench.action.closeActiveEditor",
    "outdent",
    "deleteRight",
    "actions.find",
    "editor.action.changeAll",
    "workbench.action.output.toggleOutput",
    "cursorWordLeftSelect",
    "cursorPageUp",
    "deleteWordLeft",
    "moveFileToTrash",
    "cursorWordLeft",
    "editor.action.clipboardCutAction",
    "list.focusDown",
    "renameFile",
    "acceptSelectedSuggestion",
    "cursorWordEndRight",
    "filesExplorer.paste",
    "notebook.cell.insertCodeCellBelow",
    "notebook.cell.output.selectAll",
    "notebook.cell.delete",
    "workbench.action.focusLeftGroup",
    "workbench.action.showCommands"
  ],
  "explorer.confirmDelete": false,
  "ltex.additionalRules.motherTongue": "fr",
  "ltex.additionalRules.languageModel": "en",
  "ltex.language": "en-GB",
  "Key Promoter.suggestKeybindingCreation": false,
  "workbench.list.mouseWheelScrollSensitivity": 5,
  "window.confirmSaveUntitledWorkspace": false,
  "editor.cursorBlinking": "smooth",
  "explorer.confirmDragAndDrop": false,
  "path-intellisense.autoSlashAfterDirectory": true,
  "path-intellisense.autoTriggerNextSuggestion": true,
  "workbench.iconTheme": "material-icon-theme",
  "editor.suggest.showStatusBar": true,
  "path-intellisense.extensionOnImport": true,
  "autoDocstring.docstringFormat": "numpy",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.latex.outDir": "%DIR%/output",
  "cmake.showConfigureWithDebuggerNotification": false,
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": true,
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "editor.wordWrap": "on",
  "explorer.autoReveal": "focusNoScroll",
  "notebook.lineNumbers": "on",
  "betterFolding.excludedLanguages": [],
  "explorer.confirmPasteNative": false,
  "path-intellisense.showHiddenFiles": true,
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "redhat.telemetry.enabled": false,
  "remote.SSH.connectTimeout": 60,
  // Lancer Ruff automatiquement à la sauvegarde
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit"
  },
  "editor.formatOnSave": true,
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.linting.chktex.enabled": true,
  "latex-workshop.linting.chktex.exec.path": "/usr/bin/chktex",
  "latex-workshop.linting.chktex.path": "/usr/bin/chktex",
  "latex-workshop.linting.chktex.args": [
    "-q",
    "-v0"
  ],
  "latex-workshop.linting.chktex.onChange": false,
  "latex-workshop.linting.chktex.include": [
    "**/*.tex"
  ],
  "yaml.format.enable": false,
  "ruff.lineLength": 100,
  "workbench.colorTheme": "Dracula Theme",
  "githubPullRequests.pushBranch": "always",
  "notebook.output.scrolling": true,
  "claudeCode.preferredLocation": "panel",
  "markdown-preview-enhanced.previewTheme": "vscode.css",
  "claudeCode.enableNewConversationShortcut": true,
  "chat.viewSessions.orientation": "stacked",
  "github.copilot.nextEditSuggestions.enabled": true,
  "git.confirmSync": false,
  "python.languageServer": "Default",
  "editor.minimap.size": "fill",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
}